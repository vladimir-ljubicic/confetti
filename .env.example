# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# "true" serves gallery images via Supabase image transforms (requires Pro);
# anything else serves signed original URLs (free tier / dev).
SUPABASE_IMAGE_TRANSFORMS=false

# Shared admin passcode for /admin.
ADMIN_PASSCODE=

# Bearer secret for /api/cron/* (Vercel sends it as CRON_SECRET automatically).
CRON_SECRET=
