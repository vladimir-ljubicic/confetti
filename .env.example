# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared admin passcode for /admin.
ADMIN_PASSCODE=

# Bearer secret for /api/cron/* (Vercel sends it as CRON_SECRET automatically).
CRON_SECRET=

# Photo source for `pnpm seed` (https://www.pexels.com/api/). Dev only.
PEXELS_API_KEY=

# Upload limits (defaults shown; admin devices are exempt).
UPLOAD_MAX_BATCH=100
UPLOAD_MAX_PER_WINDOW=300
UPLOAD_WINDOW_MINUTES=15
UPLOAD_MAX_FILE_MB=50
